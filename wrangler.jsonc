{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-janta-party-website-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // One-level subdomain for Cloudflare Universal SSL (*.janta.party).
  // DNS is attached by wrangler deploy; infra grants zone DNS Edit on the
  // janta.party zone to the CI deploy token (stacks/production/edge/cloudflare/nextjs-cf-template).
  "workers_dev": false,
  "routes": [
    {
      "pattern": "data-staging.janta.party",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "data-janta-party-website-staging"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "data-janta-party-db-staging",
      // Real UUID on account 0f90188c1f9c179ce6caeadc3e441e6d (old id 7f8905dd… no longer exists).
      "database_id": "54c1f30d-3e49-4d05-9618-f9c976a9faf6",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKERS_DEPLOY": "1"
  },
  "env": {
    "production": {
      "name": "data-janta-party-website",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "data.janta.party",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "data-janta-party-db-production",
          // Real UUID on account 0f90188c1f9c179ce6caeadc3e441e6d (old id caf0bde2… no longer exists).
          "database_id": "0b99b0f8-9632-4933-a10e-019a49caa89b",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "services": [
        {
          // Must match production worker `name` above (self-binding for OpenNext).
          "binding": "WORKER_SELF_REFERENCE",
          "service": "data-janta-party-website"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "CLOUDFLARE_WORKERS_DEPLOY": "1"
      }
    }
  }
}
