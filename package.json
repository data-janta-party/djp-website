{
  "name": "djp-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "node scripts/prepare-cloudflare-build.mjs && opennextjs-cloudflare build",
    "build:cloudflare:ci": "pnpm run build:cloudflare",
    "preview": "pnpm run build:cloudflare && opennextjs-cloudflare preview",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "preview:cloudflare:local": "bash scripts/preview-cloudflare-local.sh",
    "deploy:cloudflare": "pnpm run build:cloudflare && opennextjs-cloudflare deploy",
    "deploy": "pnpm run deploy:cloudflare",
    "start": "next start",
    "lint": "eslint app components lib actions hooks config scripts open-next.config.ts wrangler.jsonc next.config.ts eslint.config.mjs",
    "lint:structure": "node scripts/lint-structure.mjs",
    "verify:element-ids": "node scripts/verify-element-ids.mjs",
    "verify:pre-commit": "pnpm run lint:structure && pnpm run lint && pnpm run typecheck && pnpm run test:fast && pnpm run knip && pnpm run test:eslint-rules && pnpm run verify:element-ids",
    "knip": "knip",
    "jscpd": "jscpd --config .jscpd.json",
    "jscpd:ci": "jscpd --config .jscpd.json --exitCode 1",
    "format": "prettier --write . --config config/prettier.config.json",
    "format:check": "prettier --check . --config config/prettier.config.json",
    "test:eslint-rules": "vitest run --config config/vitest.eslint.config.ts",
    "test": "tsx scripts/run-vitest.ts",
    "test:fast": "vitest run --config config/vitest.fast.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:e2e:report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:generate": "node scripts/generate-ui-stories.mjs",
    "test:generate-ui": "node scripts/generate-ui-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:remote:production": "wrangler d1 migrations apply DB --remote --env production",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.511.0",
    "next": "16.2.6",
    "posthog-js": "^1.402.1",
    "radix-ui": "^1.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@cloudflare/workers-types": "^4.20260625.1",
    "@opennextjs/cloudflare": "^1.6.2",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/nextjs-vite": "^10.4.4",
    "@storybook/react": "^10.4.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jscpd": "^4.2.5",
    "jsdom": "^27.4.0",
    "knip": "^6.16.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "storybook": "^10.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.24.0"
  }
}
